{
  "name": "votes--root",
  "version": "0.0.0",
  "private": true,
  "description": "Voting systems library monorepo",
  "license": "MIT",
  "repository": "github:lzear/votes",
  "homepage": "https://github.com/lzear/votes",
  "bugs": "https://github.com/lzear/votes/issues",
  "author": "lzear",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "yarn@4.18.1",
  "scripts": {
    "build": "yarn workspaces foreach --all --topological run build",
    "build-docs": "yarn workspaces foreach --all run build-docs",
    "changeset": "changeset",
    "fix:prettier": "prettier --write \"**/*.*\"",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "housekeep": "yarn forge update && yarn test run --update && yarn qa",
    "lint": "eslint .",
    "prepare": "lefthook install",
    "qa": "yarn install --immutable && yarn build && concurrently --group 'yarn typecheck' 'yarn lint' 'yarn test' 'yarn build-docs' 'yarn forge check'",
    "setup-repo": "forge setup",
    "test": "yarn workspaces foreach --all run test",
    "typecheck": "yarn workspaces foreach --all run typecheck"
  },
  "workspaces": [
    "votes"
  ],
  "devDependencies": {
    "@changesets/cli": "^3",
    "@commitlint/cli": "^21",
    "@lzear/configs": "^6",
    "@lzear/forge": "^6",
    "@types/node": "^26",
    "@typescript/native": "npm:typescript@^7.0.2",
    "concurrently": "^10",
    "eslint": "^10",
    "lefthook": "^2",
    "prettier": "^3",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
