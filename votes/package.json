{
  "name": "votes",
  "version": "3.0.0",
  "description": "Implementation of some [electoral systems](https://en.wikipedia.org/wiki/Electoral_system)",
  "license": "MIT",
  "repository": "lzear/votes",
  "homepage": "https://github.com/lzear/votes",
  "bugs": "https://github.com/lzear/votes/issues",
  "author": "lzear",
  "type": "module",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "build-docs": "typedoc src/index.ts --tsconfig tsconfig.typedoc.json",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist",
    "src"
  ],
  "keywords": [
    "condorcet",
    "voting-systems",
    "elections"
  ],
  "devDependencies": {
    "@lzear/forge": "^4",
    "@types/node": "^26",
    "@vitest/coverage-v8": "^5",
    "tsup": "^8",
    "typedoc": "^0.28",
    "vite": "^8",
    "vitest": "^5"
  }
}
