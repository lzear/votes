{
  "name": "votes",
  "version": "3.0.0",
  "description": "TypeScript library of ranked voting methods",
  "license": "MIT",
  "repository": "lzear/votes",
  "homepage": "https://github.com/lzear/votes",
  "bugs": "https://github.com/lzear/votes/issues",
  "author": "lzear",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "engines": {
    "node": "^22.12 || >=24"
  },
  "scripts": {
    "build": "tsdown",
    "build-docs": "typedoc",
    "test": "vitest",
    "typecheck": "yarn run --top-level tsc --noEmit"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/test"
  ],
  "keywords": [
    "condorcet",
    "voting-systems",
    "elections"
  ],
  "devDependencies": {
    "@lzear/forge": "^5",
    "@types/node": "^26",
    "@vitest/coverage-v8": "^5",
    "tsdown": "^0.23",
    "typedoc": "^0.28",
    "vite": "^8",
    "vitest": "^5"
  }
}
