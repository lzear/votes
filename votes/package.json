{
  "name": "votes",
  "version": "3.0.0",
  "description": "Implementation of some [electoral systems](https://en.wikipedia.org/wiki/Electoral_system)",
  "license": "MIT",
  "repository": "lzear/votes",
  "homepage": "https://github.com/lzear/votes",
  "bugs": "https://github.com/lzear/votes/issues",
  "author": "lzear",
  "type": "module",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "typings": "./dist/index.d.ts",
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsup",
    "build-docs": "yarn typedoc",
    "release": "yarn run build",
    "test": "vitest",
    "test-prod": "yarn run test && yarn run build",
    "typecheck": "tsc --noEmit",
    "typedoc": "npx typedoc src/index.ts --tsconfig tsconfig.typedoc.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "keywords": [
    "votes",
    "condorcet",
    "voting-systems",
    "elections"
  ],
  "dependencies": {
    "lodash-es": "^4"
  },
  "devDependencies": {
    "@lzear/forge": "^4",
    "@types/lodash-es": "^4",
    "@types/node": "^26",
    "@vitest/coverage-v8": "^4",
    "rimraf": "^6",
    "tsup": "^8",
    "typedoc": "^0.28",
    "vitest": "^4"
  }
}
